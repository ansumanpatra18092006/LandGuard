# Copy to backend/.env. These values are read only by the Python backend.
# Keep the secret keys out of frontend/.env and out of VITE_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LandGuard AI
# Use the same public origin for the website and its /api reverse proxy.
PUBLIC_APP_URL=http://127.0.0.1:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173
SESSION_MINUTES=120
# Optional: project-record database. Omit to preserve the local SQLite default.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
COMPENSATION_THRESHOLD_PCT=50
POSSESSION_THRESHOLD_PCT=50
SLOW_RESPONSE_DAYS=30

# PAIMANA continuous-learning pipeline
PAIMANA_AUTO_MONITOR_ENABLED=false
PAIMANA_CHECK_INTERVAL_HOURS=6
PAIMANA_STARTUP_DELAY_SECONDS=60
# The current public PAIMANA host has presented certificate-chain issues in Python.
# Set true when the official host certificate validates normally in your environment.
PAIMANA_VERIFY_SSL=false
PAIMANA_REQUEST_TIMEOUT_SECONDS=120
PAIMANA_MIN_LABELLED_ROWS=1000
PAIMANA_MIN_ROC_AUC=0.75
PAIMANA_MIN_RECALL=0.70
PAIMANA_ALLOWED_METRIC_DROP=0.03

# Deployment wrapper (consumed by deploy/start.sh, not by pydantic settings)
# true refreshes the canonical fictional Rayagada SIH demo records after migrations.
SEED_DEMO_DATA=false
